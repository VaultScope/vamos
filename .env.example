# VAMOS (VaultScope API) - Environment Configuration

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# PostgreSQL connection string
# Format: postgres://username:password@host:port/database
DATABASE_URL=postgres://vaultscope:vaultscope_dev@localhost:5432/vaultscope

# Maximum number of database connections in the pool
DB_MAX_CONNECTIONS=10

# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# Host address to bind to (0.0.0.0 = all interfaces)
HOST=0.0.0.0

# Port to listen on
PORT=3000

# ==============================================================================
# SECURITY - JWT TOKENS
# ==============================================================================
# Secret for signing JWT tokens (MUST be 64+ bytes for security)
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-random-64-byte-string-use-openssl-rand-base64-64

# JWT token expiration time in seconds (default: 3600 = 1 hour)
JWT_EXPIRATION_SECS=3600

# ==============================================================================
# SECURITY - ENCRYPTION
# ==============================================================================
# Encryption key for storing sensitive data (API keys, credentials)
# MUST be exactly 32 bytes for AES-256-GCM
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=change-me-to-a-random-32-byte-key-openssl-rand-base64-32

# ==============================================================================
# AUTHENTIK OIDC CONFIGURATION
# ==============================================================================
# Authentik instance URL (your identity provider)
AUTHENTIK_ISSUER=https://auth.vaultscope.de

# Admin panel OIDC client configuration
AUTHENTIK_CLIENT_ID_ADMIN=vaultscope-admin
AUTHENTIK_CLIENT_SECRET_ADMIN=change-me-to-authentik-admin-client-secret

# Storefront OIDC client configuration
AUTHENTIK_CLIENT_ID_STOREFRONT=vaultscope-storefront
AUTHENTIK_CLIENT_SECRET_STOREFRONT=change-me-to-authentik-storefront-client-secret

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
# Allowed origins for CORS (comma-separated, no spaces)
# Include all frontend origins (dev and production)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://vaultscope.de,https://admin.vaultscope.de

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
# Redis connection string (used for OIDC state validation and caching)
# Format: redis://[password@]host:port[/database]
REDIS_URL=redis://localhost:6379

# Redis key TTL for OIDC state tokens (seconds)
REDIS_STATE_TTL_SECS=300

# ==============================================================================
# JOB RUNNER CONFIGURATION
# ==============================================================================
# How often the job runner polls for new jobs (seconds)
JOB_POLL_INTERVAL_SECS=5

# Maximum number of concurrent jobs
JOB_MAX_CONCURRENT=10

# Job timeout (seconds)
JOB_TIMEOUT_SECS=1800

# ==============================================================================
# RATE LIMITING
# ==============================================================================
# Rate limit for anonymous requests (requests per minute)
RATE_LIMIT_ANONYMOUS=60

# Rate limit for authenticated requests (requests per minute)
RATE_LIMIT_AUTHENTICATED=300

# ==============================================================================
# LOGGING
# ==============================================================================
# Rust log level (error, warn, info, debug, trace)
RUST_LOG=info

# Log format (json or pretty)
LOG_FORMAT=pretty

# ==============================================================================
# OPTIONAL: PROVIDER API KEYS
# ==============================================================================
# These can also be configured via admin panel
# Hetzner Cloud API token (for automated provisioning)
# HETZNER_API_TOKEN=your-hetzner-token-here

# OVH API credentials
# OVH_APPLICATION_KEY=your-ovh-app-key
# OVH_APPLICATION_SECRET=your-ovh-app-secret
# OVH_CONSUMER_KEY=your-ovh-consumer-key
# OVH_ENDPOINT=ovh-eu

# ==============================================================================
# OPTIONAL: EMAIL CONFIGURATION
# ==============================================================================
# SMTP settings for sending emails (invoices, notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@vaultscope.de
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=noreply@vaultscope.de

# ==============================================================================
# OPTIONAL: STRIPE CONFIGURATION
# ==============================================================================
# Stripe API keys for payment processing
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ==============================================================================
# DEVELOPMENT OPTIONS
# ==============================================================================
# Enable development mode features (more verbose logging, etc.)
# DEV_MODE=true

# Disable CSRF protection (ONLY for development/testing)
# DISABLE_CSRF=false

# SFTPGo Credentials (for automated provisioning)
# SFTPGO_URL=http://localhost:8080
# SFTPGO_USER=admin
# SFTPGO_PASS=password
