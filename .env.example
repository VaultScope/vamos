# Database
DATABASE_URL=postgres://vaultscope:vaultscope_dev@localhost:5432/vaultscope
DB_MAX_CONNECTIONS=10

# Server
HOST=0.0.0.0
PORT=3000

# JWT (generate with: openssl rand -base64 64)
JWT_SECRET=change-me-to-a-random-64-byte-string

# Encryption key for connector API keys (32 bytes, base64 or hex)
ENCRYPTION_KEY=change-me-to-a-random-32-byte-string

# Authentik OIDC
AUTHENTIK_ISSUER=https://auth.yourdomain.com
AUTHENTIK_CLIENT_ID_ADMIN=vaultscope-admin
AUTHENTIK_CLIENT_ID_STOREFRONT=vaultscope-storefront
AUTHENTIK_CLIENT_SECRET_ADMIN=change-me
AUTHENTIK_CLIENT_SECRET_STOREFRONT=change-me

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Job runner
JOB_POLL_INTERVAL_SECS=5
